# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# An editor must not touch a byte of a copied file, or its digest in
# ro-crate-metadata.json stops being true. Copied and written-here files share
# these folders, so it touches none of them.
[{schema/*,in/sparql/*,fixtures/in/*,fixtures/facts/*,fixtures/expected/*,fixtures/findings/*}]
insert_final_newline = false
trim_trailing_whitespace = false
