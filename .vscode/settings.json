{
  "json.schemas": [
    {
      "fileMatch": ["/fixtures/in/*.json"],
      "url": "./schema/fhir.schema.json"
    }
  ],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // A Turtle or SPARQL file is left as written on save: a Bridge's output is
  // committed unedited. JSON is not overridden here; .editorconfig covers a
  // copied JSON file.
  "[turtle]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  },
  "[sparql]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  }
}
