PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

# What patient.rq leaves behind: a gender that is no code of FHIR's administrative
# gender; each name with something in it (a family, a text or a given name that is not
# blank) but the one carried, the first with something in it whose use is official, else
# the first with something in it, at the name; each given name of that name that is not blank and is not the one
# carried, at the given name; and each contact point, at the contact point.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Patient" .
  {
    ?resource xyz:gender ?value .
    FILTER (!(?value IN ("male", "female", "other", "unknown")))
    BIND ("/gender" AS ?step)
    BIND (fhirr4:administrativeGenderNotMapped AS ?gap)
  }
  UNION
  {
    ?resource xyz:name ?names . ?names ?nameSlot ?name .
    FILTER (STRSTARTS(STR(?nameSlot), STR(rdf:_)))
    FILTER EXISTS {
      { ?name xyz:family ?held } UNION { ?name xyz:text ?held } UNION { ?name xyz:given ?heldGiven . ?heldGiven ?heldSlot ?held . FILTER (STRSTARTS(STR(?heldSlot), STR(rdf:_))) }
      FILTER (REPLACE(STR(?held), "^\\s+|\\s+$", "") != "")
    }
    BIND (IF(EXISTS { ?name xyz:use "official" }, 0, 1000000) + xsd:integer(STRAFTER(STR(?nameSlot), "#_")) AS ?nameRank)
    {
      SELECT ?names (MIN(?rank) AS ?carriedNameRank) {
        ?named xyz:resourceType "Patient" ; xyz:name ?names . ?names ?slot ?held .
        FILTER (STRSTARTS(STR(?slot), STR(rdf:_)))
        { ?held xyz:family ?o } UNION { ?held xyz:text ?o } UNION { ?held xyz:given ?given . ?given ?givenSlot ?o . FILTER (STRSTARTS(STR(?givenSlot), STR(rdf:_))) }
        FILTER (REPLACE(STR(?o), "^\\s+|\\s+$", "") != "")
        BIND (IF(EXISTS { ?held xyz:use "official" }, 0, 1000000) + xsd:integer(STRAFTER(STR(?slot), "#_")) AS ?rank)
      }
      GROUP BY ?names
    }
    FILTER (?nameRank != ?carriedNameRank)
    OPTIONAL { ?name xyz:text ?nameText }
    OPTIONAL { ?name xyz:family ?nameFamily }
    BIND (COALESCE(?nameText, ?nameFamily) AS ?value)
    BIND (CONCAT("/name/", STR(xsd:integer(STRAFTER(STR(?nameSlot), "#_")) - 1)) AS ?step)
    BIND (fhirr4:patientNameRepeated AS ?gap)
  }
  UNION
  {
    ?resource xyz:name ?names . ?names ?nameSlot ?name .
    FILTER (STRSTARTS(STR(?nameSlot), STR(rdf:_)))
    BIND (IF(EXISTS { ?name xyz:use "official" }, 0, 1000000) + xsd:integer(STRAFTER(STR(?nameSlot), "#_")) AS ?nameRank)
    {
      SELECT ?names (MIN(?rank) AS ?nameRank) {
        ?named xyz:resourceType "Patient" ; xyz:name ?names . ?names ?slot ?held .
        FILTER (STRSTARTS(STR(?slot), STR(rdf:_)))
        { ?held xyz:family ?o } UNION { ?held xyz:text ?o } UNION { ?held xyz:given ?given . ?given ?givenSlot ?o . FILTER (STRSTARTS(STR(?givenSlot), STR(rdf:_))) }
        FILTER (REPLACE(STR(?o), "^\\s+|\\s+$", "") != "")
        BIND (IF(EXISTS { ?held xyz:use "official" }, 0, 1000000) + xsd:integer(STRAFTER(STR(?slot), "#_")) AS ?rank)
      }
      GROUP BY ?names
    }
    ?name xyz:given ?given . ?given ?givenSlot ?value .
    FILTER (STRSTARTS(STR(?givenSlot), STR(rdf:_)) && REPLACE(STR(?value), "^\\s+|\\s+$", "") != "")
    FILTER EXISTS {
      ?given ?earlierSlot ?earlier .
      FILTER (STRSTARTS(STR(?earlierSlot), STR(rdf:_))
              && xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?givenSlot), "#_"))
              && REPLACE(STR(?earlier), "^\\s+|\\s+$", "") != "")
    }
    BIND (CONCAT("/name/", STR(xsd:integer(STRAFTER(STR(?nameSlot), "#_")) - 1), "/given/", STR(xsd:integer(STRAFTER(STR(?givenSlot), "#_")) - 1)) AS ?step)
    BIND (fhirr4:patientNameRepeated AS ?gap)
  }
  UNION
  {
    ?resource xyz:telecom ?contactPoints . ?contactPoints ?contactSlot ?contactPoint .
    FILTER (STRSTARTS(STR(?contactSlot), STR(rdf:_)))
    OPTIONAL { ?contactPoint xyz:value ?value }
    BIND (CONCAT("/telecom/", STR(xsd:integer(STRAFTER(STR(?contactSlot), "#_")) - 1)) AS ?step)
    BIND (fhirr4:patientTelecomNotCarried AS ?gap)
  }
  BIND (CONCAT(?topStep, ?containedStep, ?step) AS ?pointer)
}
