# Text files are stored and checked out with LF line endings on every platform,
# so the bytes a Linux Bridge reads are the bytes a Windows editor wrote.
* text=auto eol=lf

# A copied file's bytes must keep matching the digest recorded in
# ro-crate-metadata.json. Copied and written-here files share these folders, so
# git normalises none of them.
schema/**             -text
fixtures/in/**        -text
fixtures/expected/**  -text
fixtures/findings/**  -text
fixtures/facts/**     -text
bench/*.gz            -text
