# Text files are stored and checked out with LF line endings on every platform,
# so the bytes a Linux Bridge reads are the bytes a Windows editor wrote.
* text=auto eol=lf

# A copied file's bytes must keep matching the checksum recorded in
# ro-crate-metadata.json. Copied and written-here files share schema/ and
# fixtures/in/, so git normalises none of them. No other folder holds a copied
# file.
schema/**             -text
fixtures/in/**        -text
bench/*.gz            -text
