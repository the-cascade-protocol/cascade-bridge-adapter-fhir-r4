[] a bridge:PathEntry ;
  bridge:sourcePath "/category" ;
  bridge:verdict bridge:carriedInPart ;
  bridge:concern bridge:concernCodes ;
  bridge:namesGap fhirr4:conditionOrAllergyCategoryRepeated ;
  bridge:carriedAs
    [ bridge:inSourceRecordType "DiagnosticReport" ; bridge:inRecordClass cascade:DiagnosticReport ; bridge:asProperty cascade:reportCategory ] ,
    [ bridge:inSourceRecordType "Condition" ; bridge:inRecordClass cascade:ProblemOrDiagnosis ; bridge:asProperty cascade:conditionCategory ] ,
    [ bridge:inSourceRecordType "AllergyIntolerance" ; bridge:inRecordClass cascade:AllergyOrIntolerance ; bridge:asProperty cascade:allergyCategory ] .

