  bridge:verdict bridge:carriedInPart ;
  bridge:concern bridge:concernCodes ;
  bridge:namesGap fhirr4:conditionOrAllergyCategoryRepeated ;
  bridge:carriedAs
    [ bridge:inSourceRecordType "DiagnosticReport" ; bridge:inRecordClass cascade:DiagnosticReport ; bridge:asProperty cascade:reportCategory ] ,
    [ bridge:inSourceRecordType "Condition" ; bridge:inRecordClass cascade:ProblemOrDiagnosis ; bridge:asProperty cascade:conditionCategory ] .

[] a bridge:PathEntry ;
  bridge:sourcePath "/category/coding/display" ;
  bridge:verdict bridge:redundantWith ;
  bridge:concern bridge:concernCodes ;
  bridge:sameFactAs "/category/coding/code" .

[] a bridge:PathEntry ;
  bridge:sourcePath "/category/coding/system" ;
  bridge:verdict bridge:consumed ;
  bridge:concern bridge:concernCodes .

[] a bridge:PathEntry ;
  bridge:sourcePath "/category/text" ;
  bridge:verdict bridge:ignored ;
  bridge:concern bridge:concernText ;
  bridge:because "A category's text beside the coding that carries the category, where a Cascade term has one, a condition's and a report's, adds nothing to the coding; a category given as text with no coding is reported by category-text-findings.rq as fhirr4:categoryTextNotCarried, an Observation's by observation-findings.rq as what decides it." .

